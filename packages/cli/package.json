{
  "name": "arricurdai",
  "version": "0.3.1",
  "description": "Shows where the tokens of a Claude Code project go, stops costly resumes, and finds what earlier sessions said. Local files only.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessiodonato/arricurdai.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/alessiodonato/arricurdai#readme",
  "bugs": "https://github.com/alessiodonato/arricurdai/issues",
  "keywords": [
    "claude-code",
    "tokens",
    "cost",
    "context",
    "prompt-cache",
    "hooks",
    "cli"
  ],
  "type": "module",
  "bin": {
    "arricurdai": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "test": "tsc --noEmit && vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arricurdai/core": "workspace:*",
    "@arricurdai/transcripts": "workspace:*"
  }
}
